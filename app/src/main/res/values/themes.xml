<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ChargeMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="toolbarStyle">@style/ChargeMonitorToolbar</item>
    </style>

    <style name="ChargeMonitorToolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
    </style>
</resources>
